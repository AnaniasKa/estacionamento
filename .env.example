# Copie para .env e preencha (Supabase > Project Settings > API).
# A anon key pode ficar no frontend; a proteção real é a RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Só para build local sob outro caminho (o deploy define isto sozinho).
# VITE_BASE_PATH=/estacionamento/
